# Server Configuration
PORT=3001
NODE_ENV=development

# Anthropic Claude API (REQUIRED for AI vision analysis)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Database Configuration (PostgreSQL via Supabase or other provider)
# Get from: https://supabase.com/ (Project Settings > Database)
DATABASE_URL=postgresql://user:password@host:5432/database

# File Storage (AWS S3 or CloudFlare R2)
# AWS: https://aws.amazon.com/s3/
# CloudFlare R2: https://www.cloudflare.com/products/r2/
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_BUCKET_NAME=billuminatemd-uploads
AWS_REGION=us-east-1

# OR use local storage for development (uncomment to use local instead of S3)
# USE_LOCAL_STORAGE=true

# Stripe Payment Processing
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
